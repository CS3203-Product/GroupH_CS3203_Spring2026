{
  "manifest_version": 3,
  "name": "Distraction Blocker",
  "version": "1.0.0",
  "permissions": ["webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
}
]
}
